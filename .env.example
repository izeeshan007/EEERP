PORT=3000
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/DATABASE?retryWrites=true&w=majority
# Optional local Windows workaround: a standard mongodb:// seed-list URI.
MONGO_DIRECT_URI=
SESSION_SECRET=replace-with-a-long-random-session-secret
ADMIN_USER=replace-with-your-admin-username
ADMIN_PASS=replace-with-a-strong-admin-password

FRONTEND_URLS=http://localhost:5173,https://eternalessence.in,https://www.eternalessence.in
INTEGRATION_API_KEY=replace-with-a-long-random-shared-key
